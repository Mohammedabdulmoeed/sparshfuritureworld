export type VerifiedProductPhoto = {
  src: string;
  alt: string;
  sourcePage: string;
  licenseUrl: string;
  attribution: string;
  width: number;
  height: number;
};
const imageModules = import.meta.glob(
  "../assets/electronics/*",
  {
    eager: true,
    query: "?url",
    import: "default",
  }
) as Record<string, string>;

const localPhoto = (filename: string, alt: string): VerifiedProductPhoto => {
  const key = `../assets/electronics/${filename}`;
  const src = imageModules[key];

  if (!src) {
    console.error(`[Electronics images] File not found: ${key}`);
  }

  return {
    src: src ?? "",
    alt,
    sourcePage: "",
    licenseUrl: "",
    attribution: "Locally supplied image",
    width: 0,
    height: 0,
  };
};

